# Copy to .env. Every value has a working default for the public demo store.
BASE_URL=https://storedemo.testdino.com
API_URL=https://storedemo-api.testdino.com

# Optional: reuse an existing account instead of registering one per worker
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# "chrome" = installed Google Chrome (required on macOS 13, where Playwright
# ships no bundled Chromium). Use "chromium" on Linux/CI or newer macOS.
BROWSER_CHANNEL=chrome
